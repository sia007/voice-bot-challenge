# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The number YOU bought/verified in Twilio that will place the outbound calls.
# This must be the single E.164 number you report in the submission form.
TWILIO_FROM_NUMBER=+13334445555

# The system under test. Per the challenge instructions, do not change this.
TARGET_NUMBER=+18054398008

# --- OpenAI (Realtime API powers the simulated "patient" caller) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The old beta "gpt-4o-realtime-preview-*" models were fully retired
# May 2026. Use a current GA Realtime model -- verify what's available on
# your account with:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY" | grep -i realtime
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# --- Server ---
# Public HTTPS URL that Twilio can reach (e.g. an ngrok tunnel: `ngrok http 8000`).
# Example: https://a1b2c3d4.ngrok-free.app
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
PORT=8000

# Seconds to wait between placing each scenario call (avoid rate limits / lets you watch logs)
SECONDS_BETWEEN_CALLS=10
# Max seconds to wait for a single call to complete before moving on
CALL_TIMEOUT_SECONDS=240
